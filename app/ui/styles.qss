QPushButton#button {
    padding: 10px 20px;
    border-radius: 6px;
}

QPushButton#button:hover {
    border: 1px solid #888888;
}

QPushButton#button:pressed {
    padding-top: 11px;
    padding-bottom: 9px;
}

QLabel#title {
    font-size: 24px;
    font-weight: bold;
}